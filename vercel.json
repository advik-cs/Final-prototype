{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__route=/api/$1"
    },
    {
      "source": "/before",
      "destination": "/index.html"
    },
    {
      "source": "/during",
      "destination": "/index.html"
    },
    {
      "source": "/floodx",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    }
  ]
}
